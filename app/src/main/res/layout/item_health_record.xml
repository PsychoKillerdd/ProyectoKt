<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header con fecha y hora -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10 Nov 2025"
                android:textSize="16sp"
                android:textColor="#050505"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textViewTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textSize="14sp"
                android:textColor="#65676B"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E4E6EB"
            android:layout_marginBottom="12dp"/>

        <!-- Datos de salud en grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fila 1: Pasos y Frecuencia Cardíaca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚶 Pasos"
                        android:textSize="12sp"
                        android:textColor="#65676B"/>

                    <TextView
                        android:id="@+id/textViewSteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8,542"
                        android:textSize="16sp"
                        android:textColor="#050505"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️ FC"
                        android:textSize="12sp"
                        android:textColor="#65676B"/>

                    <TextView
                        android:id="@+id/textViewHeartRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="72 BPM"
                        android:textSize="16sp"
                        android:textColor="#050505"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 2: Sueño y SpO2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😴 Sueño"
                        android:textSize="12sp"
                        android:textColor="#65676B"/>

                    <TextView
                        android:id="@+id/textViewSleep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7.5h"
                        android:textSize="16sp"
                        android:textColor="#050505"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🫁 SpO2"
                        android:textSize="12sp"
                        android:textColor="#65676B"/>

                    <TextView
                        android:id="@+id/textViewSpO2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="98%"
                        android:textSize="16sp"
                        android:textColor="#050505"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 3: Nivel de Estrés -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😌 Estrés"
                        android:textSize="12sp"
                        android:textColor="#65676B"/>

                    <TextView
                        android:id="@+id/textViewStress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35/100"
                        android:textSize="16sp"
                        android:textColor="#050505"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⌚ Reloj"
                        android:textSize="12sp"
                        android:textColor="#65676B"/>

                    <TextView
                        android:id="@+id/textViewWatchStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Colocado"
                        android:textSize="16sp"
                        android:textColor="#050505"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
